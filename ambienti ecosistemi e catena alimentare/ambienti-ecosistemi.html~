function makePlaceholderLang(baseLang, langCode) {
    const placeholder = JSON.parse(JSON.stringify(baseLang));
    const marker = `[TRADUZIONE NECESSARIA - ${langCode.toUpperCase()}]`;
    for (let key in placeholder) {
        if (typeof placeholder[key] === 'object') {
            for (let sub in placeholder[key]) {
                if (typeof placeholder[key][sub] === 'string') {
                    placeholder[key][sub] = marker + " " + placeholder[key][sub];
                } else if (Array.isArray(placeholder[key][sub])) {
                    placeholder[key][sub] = placeholder[key][sub].map(item => marker + " " + item);
                } else if (typeof placeholder[key][sub] === 'object') {
                    for (let deep in placeholder[key][sub]) {
                        if (typeof placeholder[key][sub][deep] === 'string')
                            placeholder[key][sub][deep] = marker + " " + placeholder[key][sub][deep];
                    }
                }
            }
        } else if (typeof placeholder[key] === 'string') {
            placeholder[key] = marker + " " + placeholder[key];
        }
    }
    return placeholder;
}

