// ========== GLOBALI ==========
let currentLang = 'it';
let currentUtterance = null;

function stopSpeaking() { if(window.speechSynthesis) window.speechSynthesis.cancel(); currentUtterance = null; }

function speak(text, lang) {
    if(!window.speechSynthesis) return;
    stopSpeaking();
    let utterance = new SpeechSynthesisUtterance(text);
    let ttsCode = { it:'it-IT', en:'en-US', fr:'fr-FR', es:'es-ES', pt:'pt-BR', hi:'hi-IN', ru:'ru-RU', zh:'zh-CN', ar:'ar-SA', fil:'fil-PH' }[lang] || 'it-IT';
    utterance.lang = ttsCode;
    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
    currentUtterance = utterance;
}

function randomizeQuizOptions(lang) {
    const qData = translations[lang]?.quiz?.questions;
    if(!qData) return;
    for(let i=1;i<=20;i++) {
        let section = document.getElementById(`quiz-${i}`);
        if(!section) continue;
        const question = qData[i];
        if(!question) continue;
        const correctAnswerText = question.options[question.correct];
        let shuffled = [...question.options];
        for(let j=shuffled.length-1;j>0;j--){ let k=Math.floor(Math.random()*(j+1)); [shuffled[j],shuffled[k]]=[shuffled[k],shuffled[j]]; }
        const optionsDiv = section.querySelector('.quiz-options');
        optionsDiv.innerHTML = '';
        shuffled.forEach(opt => {
            let span = document.createElement('span');
            span.className = 'quiz-option';
            span.innerText = opt;
            span.setAttribute('data-correct', opt === correctAnswerText ? 'true' : 'false');
            optionsDiv.appendChild(span);
        });
        const pStrong = section.querySelector('.quiz-question p strong');
        if(pStrong) pStrong.innerText = question.text;
    }
}

function translatePage(lang) {
    const t = translations[lang] || translations.it;
    document.querySelectorAll('[data-translate-key]').forEach(el => {
        let keys = el.getAttribute('data-translate-key').split('.');
        let val = t;
        for(let k of keys) if(val && val[k]) val = val[k]; else break;
        if(typeof val === 'string') el.innerHTML = val;
    });
    document.body.setAttribute('dir', (lang==='ar'?'rtl':'ltr'));
    randomizeQuizOptions(lang);
}

// Crea i 20 quiz statici nel wrapper
window.addEventListener('DOMContentLoaded', () => {
    let wrapper = document.getElementById('quiz-container-wrapper');
    if(wrapper.children.length===0) {
        for(let i=1;i<=20;i++) {
            let sec = document.createElement('section');
            sec.id = `quiz-${i}`;
            sec.className = 'quiz-container';
            sec.innerHTML = `<div class="voice-controls"><button class="voice-btn start">🔊</button><button class="voice-btn stop" style="display:none;">⏹️</button></div><h2 data-translate-key="quiz.title">Quiz (${i}/20)</h2><div class="quiz-question"><p><strong></strong></p><div class="quiz-options"></div><div class="quiz-feedback"></div></div>`;
            wrapper.appendChild(sec);
        }
    }
    translatePage('it');
    attachGlobalEvents();
});

function attachGlobalEvents() {
    // Lightbox immagini (escludi quelle dentro link youtube)
    document.querySelectorAll('.section-image img').forEach(img => {
        let parentLink = img.closest('a');
        if(parentLink && parentLink.href && parentLink.href.includes('youtube.com')) return;
        img.style.cursor = 'pointer';
        img.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            let containerImg = img.closest('.section-image');
            let nextSection = containerImg ? containerImg.nextElementSibling : null;
            while(nextSection && nextSection.tagName !== 'SECTION') nextSection = nextSection.nextElementSibling;
            let textToRead = '';
            if(nextSection) {
                let clone = nextSection.cloneNode(true);
                clone.querySelectorAll('.voice-controls').forEach(el => el.remove());
                textToRead = clone.innerText.replace(/\s+/g,' ').trim();
            }
            // Lightbox
            let lb = document.createElement('div');
            lb.className = 'lightbox';
            let lbImg = document.createElement('img');
            lbImg.src = img.src;
            let closeBtn = document.createElement('div');
            closeBtn.className = 'lightbox-close';
            closeBtn.innerHTML = '✕';
            lb.appendChild(lbImg);
            lb.appendChild(closeBtn);
            document.body.appendChild(lb);
            if(textToRead) speak(textToRead, currentLang);
            const closeLightbox = () => { stopSpeaking(); lb.remove(); };
            lb.addEventListener('click', closeLightbox);
            closeBtn.addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); });
        });
    });

    // Pulsanti voce (delega)
    document.body.addEventListener('click', (e) => {
        if(e.target.classList.contains('voice-btn') && e.target.classList.contains('start')) {
            let section = e.target.closest('section');
            if(section) {
                let clone = section.cloneNode(true);
                clone.querySelectorAll('.voice-controls').forEach(el => el.remove());
                let text = clone.innerText.replace(/\s+/g,' ').trim();
                if(text) speak(text, currentLang);
                let stopBtn = section.querySelector('.voice-btn.stop');
                if(stopBtn) { e.target.style.display = 'none'; stopBtn.style.display = 'flex'; }
            }
        }
        if(e.target.classList.contains('voice-btn') && e.target.classList.contains('stop')) {
            stopSpeaking();
            let section = e.target.closest('section');
            if(section) {
                let startBtn = section.querySelector('.voice-btn.start');
                if(startBtn) { e.target.style.display = 'none'; startBtn.style.display = 'flex'; }
            }
        }
        if(e.target.classList.contains('quiz-option')) {
            let opt = e.target;
            let qDiv = opt.closest('.quiz-question');
            let fbDiv = qDiv.querySelector('.quiz-feedback');
            let isCorrect = opt.getAttribute('data-correct') === 'true';
            qDiv.querySelectorAll('.quiz-option').forEach(o => o.classList.remove('correct','incorrect'));
            opt.classList.add(isCorrect ? 'correct' : 'incorrect');
            fbDiv.textContent = isCorrect ? '✅ Correct!' : '❌ Try again!';
            fbDiv.className = `quiz-feedback ${isCorrect ? 'correct' : 'incorrect'}`;
            fbDiv.style.display = 'block';
            speak(isCorrect ? 'Correct answer!' : 'Wrong answer', currentLang);
        }
    });

    document.getElementById('check-answers')?.addEventListener('click', () => {
        let resultsList = document.getElementById('quiz-results-list');
        if(!resultsList) return;
        resultsList.innerHTML = '';
        let answers = translations[currentLang]?.quiz?.results?.answers || [];
        answers.forEach((ans,i) => { let li = document.createElement('li'); li.textContent = `${i+1}. ${ans}`; resultsList.appendChild(li); });
        document.getElementById('quiz-results').style.display = 'block';
    });
}

// Language buttons
document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentLang = this.dataset.lang;
        translatePage(currentLang);
    });
});
</script>
